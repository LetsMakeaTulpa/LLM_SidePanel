# LLM (Featherless, OpenAI-compatible). Required for live investigations and evals.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Per-role models. Override without touching code.
ROLE_PLANNER_MODEL=Qwen/Qwen2.5-72B-Instruct
ROLE_SYNTH_MODEL=deepseek-ai/DeepSeek-V3-0324
ROLE_GAP_MODEL=Qwen/Qwen2.5-72B-Instruct

# Optional data sources. Missing configuration fails open to an empty result.
SEARXNG_URL=
GITHUB_TOKEN=
COMMON_CRAWL_INDEX=

# Tunables (defaults shown).
LLM_MAX_CONCURRENCY=3
TOOL_TIMEOUT_MS=10000
EVIDENCE_MAX_CHARS=12000
CACHE_DB=./data/cache.sqlite
